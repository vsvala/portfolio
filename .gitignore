# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database
portfolio.db
portfolio.db-shm
portfolio.db-wal

# Claude Code session data
.claude/

# Playwright test artifacts
.playwright-mcp/

# Uploaded documents (added via admin panel, not source code)
public/documents/*.pdf
!public/documents/cv_*.pdf
public/documents/*.jpg
public/documents/*.jpeg
public/documents/*.png
