# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/tests/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database
portfolio.db
portfolio.db-shm
portfolio.db-wal

# Test SQLite database (created automatically by npm test)
test.db
test.db-shm
test.db-wal

# Claude Code session data
.claude/

# Playwright test artifacts
.playwright-mcp/

# Local notes — not for version control
palaute.md
kieli.md
agentti-coding-instr.md
building-project.md

# Uploaded documents (added via admin panel, not source code)
public/documents/*.pdf
!public/documents/cv_*.pdf
public/documents/*.jpg
public/documents/*.jpeg
public/documents/*.png
*.png

plan/

# Password-protected documents served only via /api/protected-doc — must never be committed
private-documents/
